{
  "name": "@kushalicious/jevcache",
  "version": "0.3.1",
  "description": "OpenAI-compatible chat proxy: skip completions when TypeSafe Jev (or local System One) says same intent. Fail-open + freshness-aware.",
  "type": "module",
  "bin": {
    "jevcache": "./bin/jevcache.js"
  },
  "files": [
    "bin",
    "dist",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "node -e \"const fs=require('fs');if(!fs.existsSync('tsconfig.json')||!fs.existsSync('src'))process.exit(0);require('child_process').execSync('npm run build',{stdio:'inherit'})\"",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "validate:systemone": "npm run build && node --experimental-sqlite scripts/validate_systemone.mjs",
    "eval": "tsx scripts/eval.ts",
    "demo": "tsx scripts/load_demo.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kushals256/jevcache.git"
  },
  "bugs": {
    "url": "https://github.com/kushals256/jevcache/issues"
  },
  "homepage": "https://github.com/kushals256/jevcache#readme",
  "keywords": [
    "jev",
    "typesafe",
    "openrouter",
    "openai",
    "cache",
    "llm",
    "proxy",
    "semantic-cache"
  ],
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
