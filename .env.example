OPENROUTER_API_KEY=sk-or-v1-...
UPSTREAM_API_KEY=sk-or-v1-...
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=
JEV_MODEL=typesafe/jev-1.13
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
INTENT_THRESHOLD=0.85
TTL_SECONDS=86400
# Temporal freshness (defaults are audience-safe; no change required)
# FRESHNESS_MODE=on
# TTL_LIVE_SECONDS=0
# TTL_SHORT_SECONDS=900
# TTL_DURABLE_SECONDS=   # defaults to TTL_SECONDS
# FRESHNESS_JEV_MIN_AGE_MS=300000
# FRESHNESS_SAMPLE_BYPASS=0
JEVCACHE_ADMIN_TOKEN=
JEVCACHE_SHADOW=0
